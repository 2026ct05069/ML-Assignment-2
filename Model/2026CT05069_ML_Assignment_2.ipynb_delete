      "cell_type": "code",
      "source": [
        "miss = df.isna().sum()\n",
        "miss_tbl = pd.DataFrame({\"missing\": miss, \"percent\": (miss / len(df) * 100).round(2)})\n",
        "miss_tbl = miss_tbl[miss_tbl[\"missing\"] > 0].sort_values(\"missing\", ascending=False)\n",
        "display(miss_tbl if len(miss_tbl) else Markdown(\"No missing values found.\"))"
      ],
