    {
      "cell_type": "code",
      "source": [
        "# 1) all six metrics for all models\n",
        "ax = results[METRICS].plot(kind=\"bar\", figsize=(12, 6), width=0.8, colormap=\"tab10\")\n",
        "ax.set_title(\"Evaluation metrics for all models (test set)\")\n",
        "ax.set_ylabel(\"Score\"); ax.set_xlabel(\"\")\n",
        "ax.set_ylim(0, 1.05)\n",
        "ax.legend(title=\"Metric\", loc=\"lower center\", ncol=6, bbox_to_anchor=(0.5, -0.45))\n",
        "plt.xticks(rotation=20, ha=\"right\"); plt.tight_layout()\n",
        "plt.savefig(RESULTS_DIR / \"metrics_bar_chart.png\", dpi=150, bbox_inches=\"tight\"); plt.show()\n",
        "\n",
        "# 2) one panel per metric\n",
        "fig, axes = plt.subplots(2, 3, figsize=(15, 8))\n",
        "for ax, metric in zip(axes.ravel(), METRICS):\n",
        "    vals = results[metric]\n",
        "    ax.bar(range(len(vals)), vals.values, color=sns.color_palette(\"viridis\", len(vals)))\n",
        "    ax.set_xticks(range(len(vals)))\n",
        "    ax.set_xticklabels([n.replace(\" (Ensemble)\", \"\") for n in vals.index], rotation=30, ha=\"right\")\n",
        "    ax.set_title(metric); ax.set_ylim(0, 1.05)\n",
        "    for i, v in enumerate(vals.values):\n",
        "        ax.text(i, v, f\"{v:.3f}\", ha=\"center\", va=\"bottom\", fontsize=8)\n",
        "fig.suptitle(\"Metric-wise comparison of the five models\", fontsize=14)\n",
        "fig.tight_layout(); fig.savefig(RESULTS_DIR / \"metrics_per_metric.png\", dpi=150); plt.show()\n",
        "\n",
        "# 3) heatmap\n",
        "plt.figure(figsize=(9, 4.5))\n",
        "sns.heatmap(results.astype(float), annot=True, fmt=\".3f\", cmap=\"YlGnBu\")\n",
        "plt.title(\"Metric heatmap\"); plt.ylabel(\"\")\n",
        "plt.tight_layout(); plt.savefig(RESULTS_DIR / \"metrics_heatmap.png\", dpi=150); plt.show()\n",
        "\n",
        "# 4) confusion matrices\n",
        "fig, axes = plt.subplots(1, len(preds), figsize=(4.2 * len(preds), 4))\n",
        "for ax, (name, pred) in zip(axes, preds.items()):\n",
        "    ConfusionMatrixDisplay.from_predictions(y_test, pred, display_labels=class_names, ax=ax, colorbar=False, cmap=\"Blues\")\n",
        "    ax.set_title(name.replace(\" (Ensemble)\", \"\"))\n",
        "fig.tight_layout(); fig.savefig(RESULTS_DIR / \"confusion_matrices.png\", dpi=150); plt.show()"
      ],
