    {
      "cell_type": "code",
      "source": [
        "TARGET = \"readmitted\"\n",
        "ID_COLS = [\"encounter_id\", \"patient_nbr\"]        # identifiers: carry no medical meaning, would only cause memorisation\n",
        "HIGH_MISSING = [\"weight\"]                        # almost entirely missing, cannot be imputed reliably\n",
        "CODED_CATEGORICAL = [\"admission_type_id\", \"discharge_disposition_id\", \"admission_source_id\"]  # integer codes, not quantities\n",
        "\n",
        "print(\"Share of missing values in 'weight': {:.1%}\".format(df_raw[\"weight\"].isna().mean()))\n",
        "df = df_raw.drop(columns=[c for c in ID_COLS + HIGH_MISSING if c in df_raw.columns]).copy()\n",
        "\n",
        "# integer codes that really are categories must not be scaled as numbers\n",
        "for c in CODED_CATEGORICAL:\n",
        "    if c in df.columns:\n",
        "        df[c] = df[c].astype(\"string\").astype(object).where(df[c].notna(), np.nan)\n",
        "\n",
        "# gender has a handful of 'Unknown/Invalid' rows: treat them as missing\n",
        "if \"gender\" in df.columns:\n",
        "    df[\"gender\"] = df[\"gender\"].replace(\"Unknown/Invalid\", np.nan)\n",
        "\n",
        "n_features = df.shape[1] - 1\n",
        "print(f\"Instances: {len(df):,} | Input features used: {n_features}\")\n",
        "assert len(df) >= 1000, \"dataset must have at least 1,000 instances\"\n",
        "assert n_features >= 12, \"dataset must have at least 12 features\"\n",
        "print(\"Minimum requirements satisfied (>= 12 features, >= 1,000 instances).\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
