    {
      "cell_type": "code",
      "source": [
        "num_cols = X_train.select_dtypes(include=\"number\").columns.tolist()\n",
        "cat_cols = [c for c in X_train.columns if c not in num_cols]\n",
        "\n",
        "\n",
        "def make_preprocessor():\n",
        "    \"\"\"Numeric: median impute + standardise. Categorical: 'Missing' level + one-hot.\n",
        "    Categories used by fewer than 1% of rows are pooled into one 'infrequent' group, so the\n",
        "    diagnosis columns (hundreds of ICD-9 codes) do not create thousands of columns.\"\"\"\n",
        "    numeric = Pipeline([(\"impute\", SimpleImputer(strategy=\"median\")),\n",
        "                        (\"scale\", StandardScaler())])\n",
        "    categorical = Pipeline([(\"impute\", SimpleImputer(strategy=\"constant\", fill_value=\"Missing\")),\n",
        "                            (\"onehot\", OneHotEncoder(handle_unknown=\"infrequent_if_exist\",\n",
        "                                                     min_frequency=0.01, sparse_output=False))])\n",
        "    return ColumnTransformer([(\"num\", numeric, num_cols), (\"cat\", categorical, cat_cols)])\n",
        "\n",
        "\n",
        "print(f\"{len(num_cols)} numerical and {len(cat_cols)} categorical columns go into the preprocessor.\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4gIkX4uOctgX",
        "outputId": "f7fcfe50-e4a2-4d98-ce45-f5b588fcc9cc"
      },
      "execution_count": 9,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "8 numerical and 38 categorical columns go into the preprocessor.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "models = {\n",
        "    \"Logistic Regression\": LogisticRegression(max_iter=1000, C=1.0, random_state=SEED),\n",
        "    \"Decision Tree\": DecisionTreeClassifier(criterion=\"gini\", max_depth=8, min_samples_leaf=5, random_state=SEED),\n",
        "    \"kNN\": KNeighborsClassifier(n_neighbors=7, weights=\"uniform\", metric=\"minkowski\", p=2),\n",
        "    \"Naive Bayes\": GaussianNB(),\n",
        "    \"Random Forest (Ensemble)\": RandomForestClassifier(n_estimators=200, min_samples_leaf=2, n_jobs=-1, random_state=SEED),\n",
        "}\n",
        "METRICS = [\"Accuracy\", \"AUC\", \"Precision\", \"Recall\", \"F1\", \"MCC\"]\n",
        "n_classes = len(class_names)\n",
        "\n",
        "\n",
        "def evaluate(pipe, X_, y_):\n",
        "    pred = pipe.predict(X_)\n",
        "    proba = pipe.predict_proba(X_)\n",
        "    avg = \"binary\" if n_classes == 2 else \"weighted\"\n",
        "    auc = roc_auc_score(y_, proba[:, 1]) if n_classes == 2 else roc_auc_score(y_, proba, multi_class=\"ovr\", average=\"macro\")\n",
        "    scores = {\n",
        "        \"Accuracy\": accuracy_score(y_, pred),\n",
        "        \"AUC\": auc,\n",
        "        \"Precision\": precision_score(y_, pred, average=avg, zero_division=0),\n",
        "        \"Recall\": recall_score(y_, pred, average=avg, zero_division=0),\n",
        "        \"F1\": f1_score(y_, pred, average=avg, zero_division=0),\n",
        "        \"MCC\": matthews_corrcoef(y_, pred),\n",
        "    }\n",
        "    return scores, pred\n",
        "\n",
        "\n",
        "fitted, rows, preds, train_acc, fit_seconds = {}, {}, {}, {}, {}\n",
        "for name, clf in models.items():\n",
        "    pipe = Pipeline([(\"preprocess\", make_preprocessor()), (\"clf\", clf)])\n",
        "    t0 = time.time()\n",
        "    pipe.fit(X_train, y_train)                       # preprocessing is fitted on X_train only\n",
        "    fit_seconds[name] = time.time() - t0\n",
        "    rows[name], preds[name] = evaluate(pipe, X_test, y_test)\n",
        "    train_acc[name] = pipe.score(X_train, y_train)\n",
        "    fitted[name] = pipe\n",
        "    joblib.dump(pipe, SAVED_DIR / (name.split(\" (\")[0].lower().replace(\" \", \"_\") + \".joblib\"))\n",
        "    print(f\"{name:<26} trained in {fit_seconds[name]:6.1f}s | test accuracy {rows[name]['Accuracy']:.4f}\")\n",
        "\n",
        "n_encoded = fitted[\"Logistic Regression\"].named_steps[\"preprocess\"].transform(X_test.head(2)).shape[1]\n",
        "print(f\"\\nFeatures after encoding: {n_encoded}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "UXlGNNRxcvsX",
        "outputId": "61106c76-e39e-47df-b558-78034cfd7518"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Logistic Regression        trained in   56.9s | test accuracy 0.5830\n",
            "Decision Tree              trained in    7.7s | test accuracy 0.5728\n",
            "kNN                        trained in    4.4s | test accuracy 0.5330\n",
            "Naive Bayes                trained in    6.5s | test accuracy 0.1649\n",
            "Random Forest (Ensemble)   trained in   55.9s | test accuracy 0.5911\n",
            "\n",
            "Features after encoding: 205\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "results = pd.DataFrame(rows).T[METRICS]\n",
        "results.index.name = \"ML Model Name\"\n",
        "results.round(4).to_csv(RESULTS_DIR / \"metrics_comparison.csv\")\n",
        "display(results.round(4))\n",
        "\n",
        "\n",
        "def to_markdown_table(res):\n",
        "    head = \"| **ML Model Name** | \" + \" | \".join(f\"**{m}**\" for m in METRICS) + \" |\"\n",
        "    sep = \"| --- \" * (len(METRICS) + 1) + \"|\"\n",
        "    body = [f\"| **{n}** | \" + \" | \".join(f\"{r[m]:.4f}\" for m in METRICS) + \" |\" for n, r in res.iterrows()]\n",
        "    return \"\\n\".join([head, sep] + body)\n",
        "\n",
        "\n",
        "table_md = to_markdown_table(results)\n",
        "(RESULTS_DIR / \"metrics_table.md\").write_text(table_md, encoding=\"utf-8\")\n",
        "print(\"Markdown version of the table (paste into README.md):\\n\")\n",
