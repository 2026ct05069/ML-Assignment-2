    {
      "cell_type": "code",
      "source": [
        "traits = {\n",
        "    \"Logistic Regression\": \"A linear model on scaled and one-hot inputs: fast, stable and well calibrated, but it cannot model non-linear interactions between features.\",\n",
        "    \"Decision Tree\": \"A single depth-limited tree: easy to interpret and able to capture non-linear splits, but a single tree is high-variance.\",\n",
        "    \"kNN\": f\"Distance based on {n_encoded} encoded features: distances become less informative in high dimensions, and prediction is slow on a large test set.\",\n",
        "    \"Naive Bayes\": \"Assumes features are independent and Gaussian; the one-hot and medication features are correlated and not Gaussian, so the assumptions are violated.\",\n",
        "    \"Random Forest (Ensemble)\": \"Averages many de-correlated trees, which reduces variance and captures non-linear interactions.\",\n",
        "}\n",
        "ranks = results.rank(ascending=False, method=\"min\").astype(int)\n",
        "\n",
        "\n",
        "def overfit_text(g):\n",
        "    if g > 0.10:\n",
        "        return f\"clear overfitting (train-test accuracy gap {g:.3f})\"\n",
        "    if g > 0.03:\n",
        "        return f\"mild overfitting (train-test accuracy gap {g:.3f})\"\n",
        "    return f\"consistent generalisation (train-test accuracy gap {g:.3f})\"\n",
        "\n",
        "\n",
        "obs_rows = []\n",
        "for name in results.index:\n",
        "    r = results.loc[name]\n",
        "    rec_col = f\"Recall for '{minority_label}'\"\n",
        "    text = (\n",
        "        f\"{traits[name]} Test accuracy {r['Accuracy']:.3f} (rank {ranks.loc[name, 'Accuracy']} of {len(results)}; \"\n",
        "        f\"majority-class baseline {majority_baseline:.3f}), AUC {r['AUC']:.3f}, F1 {r['F1']:.3f}, MCC {r['MCC']:.3f} \"\n",
        "        f\"(rank {ranks.loc[name, 'MCC']}). Fit check: {overfit_text(gap_tbl.loc[name, 'Gap (train - test)'])}. \"\n",
        "        f\"Recall for the minority class '{minority_label}' is {per_class.loc[name, rec_col]:.3f}.\"\n",
        "    )\n",
        "    obs_rows.append((name, text))\n",
        "\n",
        "wins = {m: results[m].idxmax() for m in METRICS}\n",
        "winner = results[\"MCC\"].idxmax()                      # MCC is the most reliable single score for an imbalanced multi-class target\n",
        "n_won = sum(1 for v in wins.values() if v == winner)\n",
        "winner_text = (\n",
        "    f\"**{winner}** is the overall winner: it has the highest MCC ({results.loc[winner, 'MCC']:.3f}), which is the most \"\n",
        "    f\"reliable single score on an imbalanced multi-class target, and it is best on {n_won} of the 6 metrics \"\n",
        "    f\"(best per metric: \" + \", \".join(f\"{m}: {v}\" for m, v in wins.items()) + \"). \"\n",
        "    f\"Its AUC is {results.loc[winner, 'AUC']:.3f} and its train-test accuracy gap is {gap_tbl.loc[winner, 'Gap (train - test)']:.3f}.\"\n",
        ")\n",
        "obs_rows.append((\"Overall Winner for your dataset?\", winner_text))\n",
        "\n",
        "obs_md = \"| ML Model Name | Observation about model performance |\\n| --- | --- |\\n\" + \"\\n\".join(\n",
        "    f\"| **{n}** | {t} |\" for n, t in obs_rows)\n",
        "(RESULTS_DIR / \"observations.md\").write_text(obs_md, encoding=\"utf-8\")\n",
        "display(Markdown(obs_md))"
      ],
