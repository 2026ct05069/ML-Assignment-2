    {
      "cell_type": "code",
      "source": [
        "gap_tbl = pd.DataFrame({\"Train accuracy\": pd.Series(train_acc), \"Test accuracy\": results[\"Accuracy\"]})\n",
        "gap_tbl[\"Gap (train - test)\"] = gap_tbl[\"Train accuracy\"] - gap_tbl[\"Test accuracy\"]\n",
        "gap_tbl[\"Training time (s)\"] = pd.Series(fit_seconds)\n",
        "display(gap_tbl.round(4))\n",
        "\n",
        "minority_idx = class_names.index(minority_label)\n",
        "per_class = pd.DataFrame(\n",
        "    {n: recall_score(y_test, p, average=None, labels=range(n_classes), zero_division=0) for n, p in preds.items()},\n",
        "    index=[f\"Recall for '{c}'\" for c in class_names],\n",
        ").T\n",
        "display(per_class.round(4))\n",
        "gap_tbl.round(4).to_csv(RESULTS_DIR / \"train_vs_test_accuracy.csv\")\n",
        "per_class.round(4).to_csv(RESULTS_DIR / \"per_class_recall.csv\")"
      ],
