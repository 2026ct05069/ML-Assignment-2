    {
      "cell_type": "code",
      "source": [
        "label_enc = LabelEncoder()\n",
        "y = label_enc.fit_transform(df[TARGET])\n",
        "class_names = list(label_enc.classes_)\n",
        "print(\"Target encoding:\", dict(enumerate(class_names)))\n",
        "\n",
        "X = df.drop(columns=[TARGET])\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.20, stratify=y, random_state=SEED     # stratify keeps the class distribution\n",
        ")\n",
        "print(f\"Train: {X_train.shape} | Test: {X_test.shape}\")\n",
        "chk = pd.DataFrame({\n",
        "    \"full data %\": pd.Series(y).value_counts(normalize=True).sort_index() * 100,\n",
        "    \"train %\": pd.Series(y_train).value_counts(normalize=True).sort_index() * 100,\n",
        "    \"test %\": pd.Series(y_test).value_counts(normalize=True).sort_index() * 100,\n",
        "}).round(2)\n",
        "chk.index = class_names\n",
        "display(chk)\n",
        "\n",
        "# save the raw (un-preprocessed) test set required in the GitHub repo\n",
        "test_out = X_test.copy()\n",
        "test_out[TARGET] = label_enc.inverse_transform(y_test)\n",
        "test_out.to_csv(ROOT / \"test_data.csv\", index=False)\n",
        "print(\"Saved:\", ROOT / \"test_data.csv\")"
      ],
