            "Minimum requirements satisfied (>= 12 features, >= 1,000 instances).\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "X_all = df.drop(columns=[TARGET])\n",
        "num_cols = X_all.select_dtypes(include=\"number\").columns.tolist()\n",
        "cat_cols = [c for c in X_all.columns if c not in num_cols]\n",
        "print(f\"Numerical features ({len(num_cols)}):\\n{num_cols}\\n\")\n",
        "print(f\"Categorical features ({len(cat_cols)}):\\n{cat_cols}\")"
      ],
      "metadata": {
