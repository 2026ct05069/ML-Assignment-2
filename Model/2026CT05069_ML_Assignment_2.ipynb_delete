    {
      "cell_type": "code",
      "source": [
        "dup_raw = df_raw.duplicated().sum()\n",
        "dup_features = df.duplicated().sum()\n",
        "print(f\"Duplicate rows in the raw file (including ID columns): {dup_raw}\")\n",
        "print(f\"Duplicate rows after removing ID columns / weight   : {dup_features}\")\n",
        "\n",
        "# rows with a missing target cannot be used for supervised learning\n",
        "before = len(df)\n",
        "df = df.dropna(subset=[TARGET]).drop_duplicates().reset_index(drop=True)\n",
        "print(f\"Rows removed (missing target + duplicates): {before - len(df)} | rows remaining: {len(df):,}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
